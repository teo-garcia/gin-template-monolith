# Application (dev default; review APP_ENV, DOCS_ENABLED, and OPENAPI_SERVER_URL per environment)
APP_ENV=development
APP_NAME=Gin Monolith Template
PORT=3000
HTTP_PORT=8080
API_PREFIX=/api/v1
API_VERSION=1
SHUTDOWN_TIMEOUT=10s
REQUEST_TIMEOUT=30s
DOCS_ENABLED=true
OPENAPI_SERVER_URL=http://localhost:3000

# Database (required change in production; never reuse local credentials)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gin_monolith?sslmode=disable
DATABASE_NAME=gin_monolith
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_PORT=5432
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=0
DATABASE_MAX_LIFETIME=1h
DATABASE_CONN_TIMEOUT=5s

# Redis (required change in production when Redis is not local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600s

# Logging (LOG_JSON=false gives human-readable local output)
LOG_LEVEL=info
LOG_JSON=true

# CORS (required change in staging/production; never use wildcard origins)
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:3000

# Rate limiting (review per environment)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Metrics (disable only when another telemetry path owns metrics)
METRICS_ENABLED=true

# Tracing (local observability stack uses http://otel-collector:4318/v1/traces in Docker)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=gin-template-monolith
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# pgAdmin (local docker only; not used by production compose)
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
